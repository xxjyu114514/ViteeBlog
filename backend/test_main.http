# 79. 验证归档数据格式（应该返回 [{year, month, count}, ...]）
# 注意：此测试用于检查返回的数据结构是否正确
GET http://127.0.0.1:8000/api/v1/article/public/archive

> {% 
    var archive = JSON.parse(response.body);
    if (archive && archive.length > 0) {
        console.log("归档数据统计:");
        archive.forEach(function(item) {
            console.log(item.year + "年" + item.month + "月: " + item.count + "篇文章");
        });
    } else {
        console.log("暂无归档数据");
    }
%}


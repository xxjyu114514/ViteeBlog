# ViteeBlog API 测试文件
# 使用方法：在 IntelliJ IDEA / PyCharm 中点击每个请求旁边的运行按钮

GET http://127.0.0.1:8000/
Accept: application/json

###

GET http://127.0.0.1:8000/docs
Accept: text/html

###


# ==================== 认证与用户管理 ====================

# 1. 管理员登录（返回 access_token, token_type, user）
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "Baozi",
  "password": "123456"
}

> {% client.global.set("admin_token", response.body.access_token); %}

###

# 2. 普通用户登录（返回 access_token, token_type, user）
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "Van",
  "password": "123456"
}

> {% client.global.set("user_token", response.body.access_token); %}

###

# 2.1 查看登录返回的完整用户信息
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

> {% 
    client.global.set("user_token_full", response.body.access_token);
    var userInfo = response.body.user;
    console.log("用户ID: " + userInfo.id);
    console.log("用户名: " + userInfo.username);
    console.log("邮箱: " + userInfo.email);
    console.log("角色: " + userInfo.role);
%}

###

# 2.2 发送注册验证码
POST http://127.0.0.1:8000/api/v1/auth/send-register-code
Content-Type: application/json

{
  "email": "293529819@qq.com"
}

###

# 2.3 用户注册（需要先执行 2.2 获取验证码）
# 注意：因为后端使用了 embed=True，所以需要嵌套结构
POST http://127.0.0.1:8000/api/v1/auth/register
Content-Type: application/json

{
  "user_in": {
    "username": "Van",
    "email": "293529819@qq.com",
    "password": "123456"
  },
  "email_code": "443510"
}

###

# 2.4 修改个人密码
PUT http://127.0.0.1:8000/api/v1/auth/change-password
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "old_password": "123456",
  "new_password": "123456"
}

###

# 2.5 发送找回密码验证码
POST http://127.0.0.1:8000/api/v1/auth/forgot-password/send-code
Content-Type: application/json

{
  "email": "293529819@qq.com"
}

###

# 2.6 重置密码（需要先执行 2.5 获取验证码）
POST http://127.0.0.1:8000/api/v1/auth/forgot-password/reset
Content-Type: application/json

{
  "email": "293529819@qq.com",
  "code": "094420",
  "new_password": "123456"
}

###

# 2.7 注销个人账号（注意：管理员不能注销）
DELETE http://127.0.0.1:8000/api/v1/auth/delete-account
Authorization: Bearer {{user_token}}

###

# 2.8 【超级管理员】修改用户角色
PUT http://127.0.0.1:8000/api/v1/auth/admin/users/2/role
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "new_role": "admin"
}

###

# 2.9 【管理员】恢复已注销账号
# 注意：需要先执行 2.7 注销账号，然后将被注销用户的 ID 替换下面的 user_id
PUT http://127.0.0.1:8000/api/v1/auth/admin/users/6/restore
Authorization: Bearer {{admin_token}}

###

# 2.10 修改个人资料（修改昵称和头像）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "username": "test",
  "avatar": null
}

###

# 2.11 仅修改昵称
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "username": "van"
}

###

# 2.12 仅修改头像
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "avatar": "/storage/avatars/avatar_test.jpg"
}

###

# 2.13 异常场景 - 修改昵称为已存在的用户名（应返回 400）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "username": "Baozi"
}

###

# 2.14 异常场景 - 未登录用户尝试修改资料（应返回 401）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Content-Type: application/json

{
  "username": "TestUser"
}

###

# 2.15 异常场景 - 登录失败次数过多（连续3次错误密码）
# 注意：这些测试会导致 testuser 账号被锁定15分钟
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "wrong_password_1"
}

###

POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "wrong_password_2"
}

###

POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "wrong_password_3"
}

###

# 2.11 异常场景 - 账号锁定后尝试登录（应返回 423）
# 注意：如果此测试返回 423，说明账号已被锁定，需要等待15分钟或手动重置数据库中的 login_attempts 字段
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

###

# 2.12 【修复】如果 testuser 被锁定，可以执行以下 SQL 手动解锁：
# UPDATE user SET login_attempts = 0, last_fail_time = NULL WHERE username = 'testuser';
# 或者等待15分钟后自动解锁

###

# 2.13 异常场景 - 已注销账号尝试登录（应返回 403）
# 注意：需要先执行 2.7 注销账号后再测试
POST http://127.0.0.1:8000/api/v1/auth/login
Content-Type: application/json

{
  "username": "deleted_user",
  "password": "123456"
}

###


# ==================== 用户主页与社交功能 ====================

# 80. 获取管理员个人主页信息（user_id=5）
# 返回包含统计字段：total_articles, total_likes_received, total_views, total_favorites, total_comments, last_active_at
GET http://127.0.0.1:8000/api/v1/users/5

###

# 81. 获取普通用户个人主页信息（user_id=6，已登录用户会返回 is_following 状态）
GET http://127.0.0.1:8000/api/v1/users/6
Authorization: Bearer {{user_token}}

###

# 82. 获取不存在的用户主页（应返回 404）
GET http://127.0.0.1:8000/api/v1/users/999999

###

# 83. 获取普通用户的文章列表（user_id=6，公开接口，默认分页）
GET http://127.0.0.1:8000/api/v1/users/6/articles?page=1&size=10

###

# 84. 获取普通用户的文章列表（user_id=6，自定义分页参数）
GET http://127.0.0.1:8000/api/v1/users/6/articles?page=1&size=5

###

# 85. 获取不存在的用户文章列表（应返回 404）
GET http://127.0.0.1:8000/api/v1/users/999999/articles?page=1&size=10

###

# 86. 修改个人资料 - 仅修改 bio（个人简介）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "bio": "这是一个热爱技术的全栈开发者"
}

###

# 87. 修改个人资料 - 同时修改 username 和 bio
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "username": "van_updated",
  "bio": "更新后的个人简介，热爱开源和技术分享"
}

###

# 88. 修改个人资料 - 同时修改 avatar 和 bio
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "avatar": "/storage/avatars/avatar_test.jpg",
  "bio": "添加了头像和个人简介"
}

###

# 89. 修改个人资料 - 清空 bio（设置为 null）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "bio": null
}

###

# 90. 异常场景 - bio 超过最大长度 200 字符（应返回 422）
PUT http://127.0.0.1:8000/api/v1/auth/update-profile
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "bio": "这是一段非常长的个人简介，超过了系统允许的最大长度限制。系统规定的最大长度为200个字符，超出部分将会导致验证失败。这段文字故意写得很长，用来测试后端是否正确实施了字段长度校验逻辑。如果后端没有正确校验，可能会导致数据库存储异常或者前端显示问题。因此，这个测试用例非常重要，用以确保系统的健壮性和数据完整性。"
}

###

# 91. 验证统计字段 - 使用已有用户测试
# 91.1 查看管理员主页（user_id=5，应该包含统计数据）
GET http://127.0.0.1:8000/api/v1/users/5
Authorization: Bearer {{user_token}}

###

# 91.2 查看普通用户主页（user_id=6，验证统计字段）
# 应该返回：total_articles, total_likes_received, total_views, total_favorites, total_comments, last_active_at
GET http://127.0.0.1:8000/api/v1/users/6
Authorization: Bearer {{user_token}}

###

# 91.3 给普通用户的文章点赞（用于验证 total_likes_received）
# 直接使用 user_id=6 的第一篇文章ID（从上面的响应可知是 35）
# 如果文章ID不同，请手动修改下面的数字
POST http://127.0.0.1:8000/api/v1/article/35/like
Authorization: Bearer {{user_token}}

###

# 91.4 再次查看普通用户主页（user_id=6，验证 total_likes_received 增加）
# 应该看到 total_likes_received 比之前多 1
GET http://127.0.0.1:8000/api/v1/users/6
Authorization: Bearer {{user_token}}

###


# ==================== 元数据管理（分类与标签） ====================

# 3. 管理员创建分类
POST http://127.0.0.1:8000/api/v1/meta/categories
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Python"
}

> {% client.global.set("category_id", response.body.id); %}

###

# 4. 普通用户创建标签
POST http://127.0.0.1:8000/api/v1/meta/tags
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "name": "Vue"
}

> {% client.global.set("tag_id", response.body.id); %}

###

# 5. 查看所有分类
GET http://127.0.0.1:8000/api/v1/meta/categories

###

# 6. 查看所有标签
GET http://127.0.0.1:8000/api/v1/meta/tags

###


# ==================== 文章管理核心流程 ====================

# 7. 图片上传测试（注意：有频率限制，每小时最多15次）
POST http://127.0.0.1:8000/api/v1/article/upload-image
Authorization: Bearer {{admin_token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./test_image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# 自定义文章ID测试变量（可手动修改此处的值来测试不同文章）
# 将此值改为您想测试的文章ID，例如: 1, 2, 3 等
> {% client.global.set("custom_article_id", "27"); %}

###

# 8. 创建文章（草稿）- 使用 content 字段
# category_id 是可选字段，这里设置为 null 表示不指定分类
POST http://127.0.0.1:8000/api/v1/article/autosave
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "title": "测试文章114",
  "summary": "这是测试摘要514",
  "content": "# 测试文章\n\n这是文章内容，使用 Markdown 格式。\n\n## 副标题\n\n一些测试内容...",
  "category_id": null,
  "tag_ids": [],
  "cover_image": null,
  "content_hash": null,
  "version": null
}

> {% client.global.set("article_id", response.body.id); %}

###

# 9. 更新文章 - 修改内容和标题（id 必须传入）
POST http://127.0.0.1:8000/api/v1/article/autosave
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "id": {{article_id}},
  "title": "测试文章（已更新）",
  "summary": "更新后的摘要",
  "content": "# 更新后的文章\n\n这是更新后的内容。\n\n## 新章节\n\n添加了新的内容段落。",
  "category_id": null,
  "tag_ids": [],
  "cover_image": null,
  "content_hash": null,
  "version": 1
}

###

# 10. 获取文章详情（返回 Article 对象，包含所有字段包括审核信息）
# 方式1：使用自动保存的文章ID
GET http://127.0.0.1:8000/api/v1/article/{{article_id}}
Authorization: Bearer {{admin_token}}

###

# 10.1 获取文章详情（使用自定义文章ID，可手动修改上面的 custom_article_id 变量）
GET http://127.0.0.1:8000/api/v1/article/{{custom_article_id}}
Authorization: Bearer {{admin_token}}

###

# 11. 我的文章列表（新版分页接口，返回包含 size 字段）
# 返回格式: { "items": [...], "total": 10, "page": 1, "size": 10, "pages": 1 }
GET http://127.0.0.1:8000/api/v1/article/my/list?page=1&size=10
Authorization: Bearer {{admin_token}}

###

# 12. 公开文章列表（新版分页接口，支持分类筛选，返回包含 size 字段）
# 返回格式: { "items": [...], "total": 10, "page": 1, "size": 10, "pages": 1 }
GET http://127.0.0.1:8000/api/v1/article/public/list?page=1&size=10

###

# 13. 管理员发布文章（免审直发）
PUT http://127.0.0.1:8000/api/v1/article/{{article_id}}/publish
Authorization: Bearer {{admin_token}}

###


# ==================== 普通用户提交流程 ====================

# 14. 普通用户创建文章 - 使用 content 字段
# category_id 是可选字段，这里设置为 null 表示不指定分类
POST http://127.0.0.1:8000/api/v1/article/autosave
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "title": "普通用户的文章",
  "summary": "需要审核的文章",
  "content": "# 普通用户文章\n\n这是一篇需要审核的文章内容。\n\n## 正文\n\n详细内容在这里...",
  "category_id": null,
  "tag_ids": [],
  "cover_image": null,
  "content_hash": null,
  "version": null
}

> {% client.global.set("user_article_id", response.body.id); %}

###

# 15. 普通用户提交审核
PUT http://127.0.0.1:8000/api/v1/article/{{user_article_id}}/publish
Authorization: Bearer {{user_token}}

###

# 16. 普通用户撤回审核
POST http://127.0.0.1:8000/api/v1/article/{{user_article_id}}/withdraw
Authorization: Bearer {{user_token}}

###


# ==================== 管理员审核流程 ====================

# 17. 查看待审核文章列表（返回包含 size 字段）
# 返回格式: { "items": [...], "total": 5, "page": 1, "size": 20, "pages": 1 }
GET http://127.0.0.1:8000/api/v1/article/admin/pending
Authorization: Bearer {{admin_token}}

###

# 18. 管理员审核通过（注意：需要先执行第14-16步创建并提交文章）
# 审核接口使用 POST 方法，传递 pass_audit 和 remark 参数
POST http://127.0.0.1:8000/api/v1/article/admin/articles/{{user_article_id}}/review
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "pass_audit": true,
  "remark": null
}

###

# 19. 管理员审核驳回（需要先重新提交）
# 先让普通用户再次提交
PUT http://127.0.0.1:8000/api/v1/article/{{user_article_id}}/publish
Authorization: Bearer {{user_token}}

###

# 然后管理员驳回（驳回时必须填写 remark）
POST http://127.0.0.1:8000/api/v1/article/admin/articles/{{user_article_id}}/review
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "pass_audit": false,
  "remark": "内容需要进一步完善"
}

###


# ==================== 回收站操作 ====================

# 20. 软删除文章
DELETE http://127.0.0.1:8000/api/v1/article/{{article_id}}
Authorization: Bearer {{admin_token}}

###

# 21. 恢复文章
POST http://127.0.0.1:8000/api/v1/article/{{article_id}}/restore
Authorization: Bearer {{admin_token}}

###

# 22. 硬删除（彻底删除）- 注意：执行后 article_id 将不可用
DELETE http://127.0.0.1:8000/api/v1/article/{{article_id}}/hard
Authorization: Bearer {{admin_token}}

###

# 23. 管理员全站列表（默认不显示已删除文章，返回包含 size 字段）
# 返回格式: { "items": [...], "total": 10, "page": 1, "size": 10, "pages": 1 }
GET http://127.0.0.1:8000/api/v1/article/admin/all-articles?page=1&size=10&show_deleted=false
Authorization: Bearer {{admin_token}}

###

# 24. 管理员全站列表（显示已删除文章，返回包含 size 字段）
# 返回格式: { "items": [...], "total": 12, "page": 1, "size": 10, "pages": 2 }
GET http://127.0.0.1:8000/api/v1/article/admin/all-articles?page=1&size=10&show_deleted=true
Authorization: Bearer {{admin_token}}

###


# ==================== 评论管理核心流程 ====================

# 25. 创建用于评论测试的文章（如果 article_id 未设置）
# 注意：如果前面的文章测试已经创建了文章并设置了 article_id，可以跳过此步骤
POST http://127.0.0.1:8000/api/v1/article/autosave
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "title": "评论功能测试文章",
  "summary": "专门用于测试评论功能的文章",
  "content": "# 评论测试\n\n这篇文章用于测试评论系统。",
  "category_id": null,
  "tag_ids": [],
  "cover_image": null,
  "content_hash": null,
  "version": null
}

> {% client.global.set("article_id", response.body.id); %}

###

# 25.1 发布文章（确保文章是 published 状态）
PUT http://127.0.0.1:8000/api/v1/article/{{article_id}}/publish
Authorization: Bearer {{admin_token}}

###

# 26. 普通用户发表评论
POST http://127.0.0.1:8000/api/v1/comments/articles/{{article_id}}/comments
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "content": "这是一篇很棒的文章！学到了很多知识。",
  "parent_id": null
}

> {% client.global.set("comment_id", response.body.id); %}

###

# 26. 回复评论（二级评论）
POST http://127.0.0.1:8000/api/v1/comments/articles/{{article_id}}/comments
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "content": "谢谢你的支持！很高兴能帮到你。",
  "parent_id": {{comment_id}}
}

> {% client.global.set("reply_id", response.body.id); %}

###

# 27. 获取文章的所有评论
GET http://127.0.0.1:8000/api/v1/comments/articles/{{article_id}}/comments

###

# 28. 用户删除自己的评论
DELETE http://127.0.0.1:8000/api/v1/comments/{{comment_id}}
Authorization: Bearer {{user_token}}

###

# 29. 管理员删除任意评论
DELETE http://127.0.0.1:8000/api/v1/comments/{{reply_id}}
Authorization: Bearer {{admin_token}}

###

# 30. 举报评论
POST http://127.0.0.1:8000/api/v1/comments/{{comment_id}}/report
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "reason": "评论内容包含不当言论"
}

###

# 31. 管理员查看待处理举报列表
GET http://127.0.0.1:8000/api/v1/comments/admin/reports
Authorization: Bearer {{admin_token}}

###

# 31.5. 获取举报列表以提取 report_id (用于后续测试)
GET http://127.0.0.1:8000/api/v1/comments/admin/reports
Authorization: Bearer {{admin_token}}

